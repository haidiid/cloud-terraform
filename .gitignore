# -- terraform files ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
.vm/
*.tfvars

#-- JetBrains files --
.idea

#-- Claude Code files --
.claude

#-- local credential files --#
credential/*

# CA: every file in ca/credential/tls/ (key material is still caught by the TLS rules below)
ca/credential/*
!ca/credential/tls/

# ZooKeeper client: OpenSSL configuration files only
!credential/zookeeper-client/
credential/zookeeper-client/*
!credential/zookeeper-client/tls/
credential/zookeeper-client/tls/*
!credential/zookeeper-client/tls/*.cnf

# ZooKeeper server: OpenSSL configuration files only (zookeeper-server/credential/user/ stays ignored)
zookeeper-server/credential/*
!zookeeper-server/credential/tls/
zookeeper-server/credential/tls/*
!zookeeper-server/credential/tls/*.cnf

#-- TLS Local Credential Files --#
*.key
*.crt
*.p12
*.srl
