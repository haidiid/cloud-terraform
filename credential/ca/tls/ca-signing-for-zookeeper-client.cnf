# ---
# OpenSSL configuration for generating the self-signed root CA certificate (ca.crt).
# Designated for local and development deployments only.
#
# Pre-requisite:
#    - a Self-signed CA Root Key exists
#    - ZooKeeper CSR key exists
# How to use:
#    openssl x509 -req -in zookeeper-server.csr -CA ca.crt -CAkey ca.key -extfile ca-signing-for-zookeeper-server.cnf
# ---

# ---
# defines a tls certificate signed by a Self-signed Root CA as detailed below
#    - subjectKeyIdentifier forces copying csr's tls hash key identifier as certificate's key identifier
#    - authorityKeyIdentifier forces copying  Self-signed Root CA as the identifier which signed it
#    - basicConstraints forces to not act as CA
#    - keyUsage forces this key for TLS handshake
#    - extendedKeyUsage forces the key acting as client only and authenticated as the client for mTLS
#---
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid, issuer
basicConstraints        = CA:FALSE
keyUsage                = critical, digitalSignature
extendedKeyUsage        = clientAuth
subjectAltName          = @alt_names

# ---
# [ alt_names ]: this extension will be ignored totally for the client
# ---
[ alt_names ]
DNS.1 = localhost
IP.1  = 127.0.0.1
