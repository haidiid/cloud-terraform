# ---
# OpenSSL configuration for generating the self-signed root CA certificate (ca.crt).
# Designated for local and development deployments only.
#
# Pre-requisite:
#    - a CA Root Private Key exits
# How to use:
#    openssl req -x509 -new -key ca.key -config ca.cnf -days 3650 -out ca.crt
# ---

# ---
# [req] defines the main extension executed by openssl req ... request
# default_md and prompt define hashing method for the CA public key signature and CA pulic key signature in every signed TLS certificate
# contains also other extensions to be executed
# ---
[ req ]
default_md          = sha384
prompt              = no
x509_extensions     = v3_ca
distinguished_name  = dn

# [dn] defines identity for the key included in signature, covering CA key itself and all signed certificates bringing this signature
[ dn ]
C   = ID
ST  = West Java
L   = Cirebon
O   = Kasyfillah Haidi Bysr
OU  = Self-Signed Root CA
CN  = Kasyfillah Haidi Bysr Self-Signed Root CA

# ---
# [ v3_ca ] defines the key definition as detailed below.
#    - basicConstrains forces the key as CA only and end certificate (no any intermediary CA keys could be created)
#    - keyUsage forces the key to only as CA for signing and revocation
#    - subjectKeyIdentifier forces hashing to refer this key as the signature
#    - Key ID signed this certificate, since it's self-signed it always refers itself
[ v3_ca ]
basicConstraints        = critical, CA:TRUE, pathlen:0
keyUsage                = critical, keyCertSign, cRLSign
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always
