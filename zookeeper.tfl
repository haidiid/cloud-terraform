#!/bin/bash

setenforce 0

echo "provisioning a zookeeper user"

groupadd -g 1001 ${zookeeper_username}
useradd ${zookeeper_username} -u 1001 -g 1001 -c "a ZooKeeper User"
echo "${zookeeper_password}" | passwd --stdin ${zookeeper_username}

mkdir /home/haidiid/.ssh
echo "${ssh-public-key}" > /home/haidiid/.ssh/authorized_keys

chmod 700 /home/haidiid/.ssh
chmod 600 /home/haidiid/.ssh/authorized_keys

chown -R 1001:1001 /home/haidiid/.ssh

echo "finished provisioning a zookeeper user"

echo "elevating a zookeeper user to have root command accesses"

echo "${zookeeper_configuration_sudoers}" > /etc/sudoers.d/zookeeper

chmod 440 /etc/sudoers.d/zookeeper

visudo -c -f /etc/sudoers.d/zookeeper

echo "finished elevating a zookeeper user to have root command accesses"

echo "installing java"

sudo dnf install java-25-openjdk-headless -y

java --version

echo "finished installing java"

echo "installing zookeeper"
mkdir /opt/zookeeper
mkdir -p /var/opt/zookeeper/log
mkdir -p /var/opt/zookeeper/lib/snapshot/
mkdir /var/opt/zookeeper/lib/transaction/

mkdir zookeeper
curl -o zookeeper.tar.gz -0 ${zookeeper_uri}
tar -xzf zookeeper.tar.gz --strip-components=1 -C zookeeper
rm zookeeper.tar.gz

mv /zookeeper /opt/

echo "${zookeeper_configuration_myid}" > /var/opt/zookeeper/lib/snapshot/myid
echo "${zookeeper_configuration_properties}" > /opt/zookeeper/conf/zookeeper.properties

echo "setting up zookeeper log"

cat << 'EOF' > /opt/zookeeper/conf/logback.xml
${zookeeper_configuration_log}
EOF

echo "finished up zookeeper log"

chown -R root:root /opt/zookeeper
chown -R root:root /var/opt/zookeeper

chmod -R 700 /opt/zookeeper
chmod -R 700 /var/opt/zookeeper
chmod -R 700 /var/opt/zookeeper/log
chmod -R 700 /var/opt/zookeeper/lib

echo "installing zookeeper tls keystore and truststore"

# paths must match ssl.keyStore.location / ssl.trustStore.location in zookeeper.properties
mkdir -p /opt/zookeeper/conf/tls

base64 -d > /opt/zookeeper/conf/tls/keystore.p12 << 'EOF'
${zookeeper_tls_keystore_base64}
EOF

base64 -d > /opt/zookeeper/conf/tls/truststore.p12 << 'EOF'
${zookeeper_tls_truststore_base64}
EOF

chown -R root:root /opt/zookeeper/conf/tls
chmod 700 /opt/zookeeper/conf/tls
# keystore holds the server private key: readable by root (the zookeeperd user) only
chmod 400 /opt/zookeeper/conf/tls/keystore.p12
chmod 400 /opt/zookeeper/conf/tls/truststore.p12

echo "finished installing zookeeper tls keystore and truststore"

cat << 'EOF' > /etc/rsyslog.d/zookeeper.conf
${zookeeper_configuration_rsyslog}
EOF

chown root:root /etc/rsyslog.d/zookeeper.conf

chmod 644 /etc/rsyslog.d/zookeeper.conf

systemctl restart rsyslog

cat << 'EOF' > /etc/systemd/system/zookeeperd.service
${zookeeper_configuration_systemd}
EOF

chmod 774 /etc/systemd/system/zookeeperd.service
chown root:root /etc/systemd/system/zookeeperd.service

systemctl enable zookeeperd
systemctl start zookeeperd

echo "installing zookeeper"



