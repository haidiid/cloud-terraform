[ req ]
default_md          = sha384
prompt              = no
req_extensions      = req_ext
distinguished_name  = dn

[ dn ]
C            = ID
ST           = West Java
L            = Cirebon
O            = Kasyfillah Haidi Bysr
OU           = ZooKeeper Client
CN           = zookeeper-client

[ req_ext ]
basicConstraints = CA:FALSE
keyUsage         = critical, digitalSignature
extendedKeyUsage = clientAuth
subjectAltName   = @alt_names

[ alt_names ]
DNS.1 = localhost
IP.1  = 127.0.0.1